<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00573">
	<title>Blind-Spot View</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1">
			<tgroup cols="2" colsep="1" outputclass="FormatA" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="col1" colsep="0">
							<fig>
								<figgroup>
									<image align="center" height="1.575in" href="../../images/N_TK25Z021_E.eps" placement="break" width="2.244in"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout">
								<li>
									<p> <uicontrol>Driver Assistance</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Driving Safety</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Blind-spot view monitor</uicontrol> </p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p>With the vehicle on, select <menucascade><uicontrol outputclass="a1701754">Settings</uicontrol><uicontrol outputclass="a1701772">Vehicle</uicontrol><uicontrol outputclass="a1804409">Driver assistance</uicontrol><uicontrol>Driving safety</uicontrol><uicontrol outputclass="a1804497">Blind-spot view monitor</uicontrol></menucascade> from the infotainment system screen to turn on Blind-Spot View Monitor and deselect to turn off the function.</p>
	</conbody>
</concept>