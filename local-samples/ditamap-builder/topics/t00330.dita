<concept id="t00330">
	<title>Automatic climate control system</title>
	<shortdesc>The automatic climate control system uses cooling and heating to help maintain a pleasant environment inside the vehicle.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>automatic climate control system</indexterm>
			</keywords>
		</metadata>
	</prolog>
