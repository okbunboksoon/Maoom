		<ol outputclass="callout">
			<li>
				<p>Driver only select icon</p>
			</li>
			<li>
				<p> <term translate="no">SYNC</term> icon</p>
				<ul id="e02467">
					<li>
						<p>Touch the <term translate="no">SYNC</term> icon to adjust the driver and passenger side temperature to the same value.</p>
					</li>
				</ul>
			</li>
			<li>
				<p>Mode selection icon</p>
			</li>
