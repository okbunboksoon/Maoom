<concept base="Anywhere" id="t00818">
	<title>Replacing battery junction block fuse</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e05153">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e05154">
								<figgroup>
									<image href="../../images/OOV075048L.eps" align="center" placement="break" id="e05155" scale="95"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2"/>
					</row>
				</tbody>
			</tgroup>
		</table>
		<section>
			<title>Operation</title>
			<ol>
				<li>
					<p>Turn off the vehicle.</p>
				</li>
				<li>
					<p>Take off the motor room cover from the left side of the vehicle.</p>
				</li>
				<li>
					<p>Open the 12 V battery cover (1).</p>
				</li>
				<li>
					<p>Every fuse is tightened with a nut. Do not arbitrarily disassemble or assemble the fuse.</p>
					<p>Consult a professional workshop. Kia recommends that you consult an authorized Kia dealer/service partner.</p>
				</li>
			</ol>
		</section>
	</conbody>
</concept>