			</li>
			<li>
				<p>Compressor hose</p>
			</li>
			<li>
				<p>Compressor connector valve</p>
			</li>
			<li>
				<p>Sealant bottle</p>
			</li>
			<li>
				<p>Speed restriction label</p>
			</li>
			<li>
				<p>Compressor ON/OFF switch</p>
			</li>
			<li>
				<p>Tire pressure control valve</p>
			</li>
