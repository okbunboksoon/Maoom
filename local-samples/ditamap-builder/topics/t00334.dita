<concept id="t00334">
	<title>Temperature control</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>automatic climate control system 
					<indexterm>temperature control</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e02497">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e02498">
								<figgroup>
									<image href="../../images/OOV035304.eps" align="center" height="1.740in" placement="break" id="e02499"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2"/>
