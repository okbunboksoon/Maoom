<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00595">
	<title>Smart Cruise Control conditions not satisfied</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e04258">
			<tgroup cols="2" colsep="1" outputclass="FormatA" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="col1" colsep="0">
							<fig id="e04259">
								<figgroup>
									<image align="center" height="1.573in" href="../../images/OOV055203L.eps" placement="break" id="e04260"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout" id="e04261">
								<li>
									<p> <uicontrol outputclass="c0036">SCC (Smart Cruise Control) conditions not met</uicontrol> </p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p>If the Driving Assist button, (<image align="left" href="../../images/WKIA_334.eps" outputclass="nolabel" placement="inline" scale="15" id="e04262"/>), (<image align="left" href="../../images/WKIA_335.eps" outputclass="nolabel" placement="inline" scale="15" id="e04263"/>) or (<image align="left" href="../../images/WKIA_079.eps" outputclass="nolabel" placement="inline" scale="15" id="e04264"/>) switch is operated when Smart Cruise Control operating conditions are not satisfied, the warning message will appear on the cluster, and an audible warning will sound.</p>
	</conbody>
</concept>