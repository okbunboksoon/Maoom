<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept id="t00276">
	<title id="e02087">Driving assist view</title>
	<conbody>
		<section id="e02088">
			<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e02089">
				<tgroup cols="2" colsep="0" rowsep="1">
					<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
					<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
					<tbody>
						<row rowsep="1">
							<entry colname="col1">
								<fig id="e02090">
									<figgroup>
										<image align="center" height="1.575in" href="../../images/OOV035111.eps" placement="break" width="2.244in" id="e02091"/>
									</figgroup>
								</fig>
							</entry>
							<entry colname="col2"/>
						</row>
					</tbody>
				</tgroup>
			</table>
			<p>This mode displays the state of:</p>
			<ul>
				<li>
					<p>Lane Keeping Assist</p>
				</li>
				<li>
					<p importance="optional">Blind-Spot Collision-Avoidance Assist</p>
				</li>
				<li>
					<p>Smart Cruise Control</p>
				</li>
				<li>
					<p>Lane Following Assist</p>
				</li>
				<li>
					<p importance="optional">Highway Driving Assist</p>
				</li>
			</ul>
			<p importance="default">For more details, refer to each system information in <xref href="t00443.dita#t00443"/>.</p>
		</section>
	</conbody>
</concept>