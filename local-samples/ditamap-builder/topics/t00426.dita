						</entry>
						<entry colname="col2">
							<fig id="e03112">
								<title>Type B (GT-line)</title>
								<figgroup>
									<image align="center" placement="break" height="1.575in" width="2.244in" href="../../images/OOV045028.eps" id="e03113"/>
