<concept id="t00426">
	<title>DRIVE MODE</title>
	<shortdesc>The drive mode may be selected according to the driver’s preference or road condition.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>drive mode integrated control system 
					<indexterm>DRIVE MODE</indexterm>
				</indexterm>
				<indexterm>DRIVE MODE</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
