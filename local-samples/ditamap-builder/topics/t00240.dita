<concept id="t00240">
	<title>Tilt open/close</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>wide sunroof 
					<indexterm>tilt open/close</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table frame="none" outputclass="formatc_none" rowsep="0" colsep="0" id="e01758">
			<tgroup cols="2" colsep="0" rowsep="0">
				<colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
				<colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
				<tbody>
					<row rowsep="0">
						<entry colname="col1">
							<fig id="e01759">
								<figgroup>
									<image href="../../images/OOV035097.eps" align="center" placement="break" id="e01760"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<fig id="e01761">
								<figgroup>
