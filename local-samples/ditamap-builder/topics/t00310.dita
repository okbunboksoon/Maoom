<concept id="t00310">
	<title id="e02345">Wipers and washers</title>
	<shortdesc>The wipers and washers help maintain visibility by removing water, dirt, and other foreign substances from the windshield and rear window.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>wipers and washers</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<section>
			<title>Front windshield wiper/washer</title>
			<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e02346">
				<tgroup cols="2" colsep="0" rowsep="1">
					<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
					<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
