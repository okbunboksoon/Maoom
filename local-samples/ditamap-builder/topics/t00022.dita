<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" importance="optional" id="t00022">
	<title>V2L power outlet</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e00113">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e00114">
								<figgroup>
									<image align="center" height="1.575in" href="../../images/OOVQ015020.eps" placement="break" width="2.244in" id="e00115"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<fig id="e00116">
								<figgroup>
									<image align="center" height="1.575in" href="../../images/OOVQ015022.eps" placement="break" width="2.244in" id="e00117"/>
								</figgroup>
							</fig>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<section deliveryTarget="except_digital" id="e00118">
			<title>Simple operation</title>
			<p>The V2L power outlet is located in the luggage room area.</p>
			<ol id="e00119">
				<li>
					<p>Press the EV button to the ON position.</p>
				</li>
				<li>
					<p>Slide the V2L power outlet cover to the left and connect a device.</p>
				</li>
			</ol>
		</section>
		<section deliveryTarget="except_print" id="e00120">
			<title>Operation</title>
			<ol id="e00121">
				<li>
					<p>Connect to the V2L power outlet located in the luggage room area with the EV button in the ON position.</p>
				</li>
				<li>
					<p>Slide the V2L power outlet cover to the left.</p>
				</li>
				<li>
					<p>Check the operation status through the front indicator of the power outlet.</p>
					<table frame="none" colsep="1" rowsep="1" pgwide="true" outputclass="formatc" id="e00122">
						<tgroup cols="2" colsep="1" rowsep="1" outputclass="FormatA">
							<colspec colnum="1" colname="1" colwidth="50*"/>
							<colspec colnum="2" colname="2" colwidth="50*"/>
							<thead>
								<row rowsep="1">
									<entry colname="1">
										<p>Indicator</p>
									</entry>
									<entry colname="2">
										<p>Operation Status</p>
									</entry>
								</row>
							</thead>
							<tbody>
								<row rowsep="1">
									<entry colname="1" align="center" valign="middle">
										<p>Blue</p>
									</entry>
									<entry colname="2" align="left" valign="middle">
										<p>Standby</p>
									</entry>
								</row>
								<row rowsep="1">
									<entry colname="1" align="center" valign="middle">
										<p>Red</p>
									</entry>
									<entry colname="2" align="left" valign="middle">
										<p>No power supply even the power outlet is connected</p>
									</entry>
								</row>
								<row rowsep="0">
									<entry colname="1" align="center" valign="middle">
										<p>Green</p>
									</entry>
									<entry colname="2" align="left" valign="middle">
										<p>The power outlet is connected correctly to provide power.</p>
									</entry>
								</row>
							</tbody>
						</tgroup>
					</table>
				</li>
			</ol>
		</section>
	</conbody>
</concept>