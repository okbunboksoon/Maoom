					<row rowsep="0">
						<entry namest="1" nameend="2" align="center" valign="middle">
							<p>How to Charge</p>
						</entry>
						<entry colname="3" align="center" valign="middle">
							<p>Use AC charger installed at home or public charging station</p>
						</entry>
						<entry colname="4" align="center" valign="middle">
							<p>Use the DC charger at public charging station</p>
						</entry>
						<entry colname="5" align="center" valign="middle">
