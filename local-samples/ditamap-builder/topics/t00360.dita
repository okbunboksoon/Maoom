<concept id="t00360">
	<title>Luggage board</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>storage compartment 
					<indexterm>luggage board</indexterm>
				</indexterm>
				<indexterm>luggage board</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<p>You can place reflector triangle or other items under the luggage board.</p>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e02588">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e02589">
								<figgroup>
									<image href="../../images/OOV035046.eps" align="center" height="1.740in" placement="break" id="e02590"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2"/>
					</row>
				</tbody>
			</tgroup>
		</table>
		<ol>
			<li>
				<p>Grasp the handle on the top of the cover and lift it.</p>
			</li>
			<li>
				<p>Fold the rear part of luggage board frontward.</p>
			</li>
			<li>
				<p>Lift up luggage board frontward.</p>
			</li>
		</ol>
	</conbody>
</concept>