<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00633">
	<title>Lane Following Assist malfunction</title>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e04366">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="FormatA">
				<colspec colnum="1" colname="1" colwidth="50*"/>
				<colspec colnum="2" colname="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="1" colsep="0">
							<fig id="e04367">
								<figgroup>
									<image href="../../images/OOV055180L.eps" align="center" placement="break" height="1.573in" width="2.243in" id="e04368"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="2">
							<ol outputclass="callout" id="e04369">
								<li>
									<p> <uicontrol outputclass="c0040">Check driver assistance system.</uicontrol> </p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p outputclass="across">When Lane Following Assist is not working properly, the warning message will appear and the master warning light (<image align="left" href="../../images/WKIA_040.eps" outputclass="nolabel" placement="inline" scale="15"/>) will appear on the cluster.</p>
		<p outputclass="across">If this occurs, have your vehicle inspected by a professional workshop. Kia recommends visiting an authorized Kia dealer or service partner.</p>
		<note type="note">
			<p>You can check it in the service message of the utility information view of the cluster display window.</p>
		</note>
	</conbody>
</concept>