<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00588">
	<title>Temporarily canceling Smart Cruise Control</title>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e04234">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="FormatA">
				<colspec colnum="1" colname="1" colwidth="50*"/>
				<colspec colnum="2" colname="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="1" colsep="0">
							<fig id="e04235">
								<figgroup>
									<image align="center" href="../../images/OOV055012.eps" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="2"/>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p>Press the (<image align="left" height="0.117in" href="../../images/WKIA_079.eps" outputclass="nolabel" placement="inline" width="0.117in" scale="15" id="e04236"/>) switch or depress the brake pedal to temporarily cancel Smart Cruise Control.</p>
	</conbody>
</concept>