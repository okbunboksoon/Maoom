<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00590">
	<title>Turning off Smart Cruise Control</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1">
			<tgroup cols="2" colsep="1" outputclass="FormatA" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="col1" colsep="0">
							<fig>
								<figgroup>
									<image align="center" height="1.573in" href="../../images/OOV055005.eps" placement="break" width="2.243in"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<p>Press the Driving Assist button to turn Smart Cruise Control off.</p>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<note type="note">
			<p>If your vehicle is equipped with Manual Speed Limit Assist, press and hold the Driving Assist button to turn off Smart Cruise Control. However, Manual Speed Limit Assist will turn on.</p>
		</note>
		<note type="warning">
			<p>Do not use the switches and buttons at the same time. Smart Cruise Control may not operate properly.</p>
		</note>
	</conbody>
</concept>