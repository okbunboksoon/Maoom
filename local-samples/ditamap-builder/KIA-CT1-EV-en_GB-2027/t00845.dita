<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept otherprops="legal_gen_std_008_01" base="Anywhere" id="t00845">
	<title>UAE eCall system</title>
	<conbody>
		<p>Elements of the UAE eCall system, installed in passenger compartment:</p>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e02704">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="58*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="42*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e02705">
								<figgroup>
									<image align="center" href="../../images/N_CT25F006_E.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout" id="e02706">
								<li>
									<p> <term translate="no">SOS TEST</term> button</p>
								</li>
								<li>
									<p>LED</p>
								</li>
								<li>
									<p> <term translate="no">SOS</term> button</p>
								</li>
								<li>
									<p>Microphone</p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p> <term translate="no">SOS</term> button: the driver/passenger makes an emergency call to the single duty dispatch service by pressing the button.</p>
		<p>LED: The green LED appears for 3 seconds when the <term translate="no">EV</term> button is in the <term translate="no">ON</term> position. After that they will switch off at normal operation of the system.</p>
	</conbody>
</concept>