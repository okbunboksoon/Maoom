<concept base="Anywhere" id="t00870">
	<title>Reset items</title>
	<conbody>
		<p>Items should be reset after the battery has been discharged, or the battery has been disconnected.</p>
		<ul>
			<li>
				<p>Auto up/down window</p>
			</li>
			<li>
				<p>Wide sunroof</p>
			</li>
			<li>
				<p>LCD display</p>
			</li>
			<li>
				<p>Climate control system</p>
			</li>
			<li>
				<p>Driver position memory system</p>
			</li>
			<li>
				<p>Audio/Infotainment system</p>
			</li>
		</ul>
	</conbody>
</concept>