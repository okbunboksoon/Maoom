		<ol outputclass="callout" id="e00647">
			<li>
				<p>Outside rearview mirror select switch</p>
			</li>
			<li>
				<p>Mirror adjustment control</p>
			</li>
			<li>
				<p>Mirror folding button</p>
			</li>
		</ol>
		<section deliveryTarget="except_digital">
			<title>Simple operation</title>
			<ul>
				<li>
					<p>Press the outside rearview mirror select switch (1) to select the left or right side of the mirror. (Electric type)</p>
				</li>
				<li>
					<p>Adjust the mirror adjustment control (2) to move the selected mirror.</p>
				</li>
			</ul>
		</section>
		<section deliveryTarget="except_print">
			<title>Operation</title>
			<ul>
				<li>
					<p>Press the outside rearview mirror select switch (1) to select the left or right side of the mirror. (Electric type)</p>
				</li>
				<li>
					<p>Adjust the mirror adjustment control (2) to move the selected mirror.</p>
				</li>
			</ul>
		</section>
