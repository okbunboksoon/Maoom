<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00229">
	<title id="e01038">Adjusting the height of the shoulder belt</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e01039">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e01040">
								<figgroup>
									<image align="center" href="../../images/N_CT25B032.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout" id="e01041">
								<li>
									<p>Height adjuster button</p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<section deliveryTarget="except_digital">
			<title>Simple operation</title>
			<ul>
				<li>
					<p>Pull the height adjuster up.</p>
				</li>
				<li>
					<p>Press the height adjuster button (1) and push the height adjuster down.</p>
				</li>
			</ul>
		</section>
		<section deliveryTarget="except_print">
			<title>Operation</title>
			<ul>
				<li>
					<p>Pull the height adjuster up. Press the height adjuster button (1) and push the height adjuster down.</p>
				</li>
			</ul>
			<note type="tip">
				<p>There will be an audible “click” when the tab locks into the buckle.</p>
			</note>
		</section>
	</conbody>
</concept>