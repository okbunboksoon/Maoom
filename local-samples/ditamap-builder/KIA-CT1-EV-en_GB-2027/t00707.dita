<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00707">
	<title>Highway Driving Assist</title>
	<conbody>
		<note type="note">
			<ul>
				<li>
					<p>The following warning message will appear on the LCD display.</p>
					<p>For more details, refer to the display and control section of the function.</p>
					<ul>
						<li>
							<p importance="high">Use switch or pedal to accelerate</p>
						</li>
						<li>
							<p importance="high">Keep hands on steering wheel</p>
						</li>
						<li>
							<p importance="high">HDA (Highway Driving Assist) system. canceled</p>
						</li>
						<li>
							<p importance="high">Driver’s grasp not detected. Lane Following Assist disabled temporarily</p>
						</li>
					</ul>
				</li>
			</ul>
		</note>
	</conbody>
</concept>