<concept otherprops="legal_eu_std_027_01" id="t00233">
	<title id="e01075">Seat belt warning light</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>seat belts 
					<indexterm>seat belt warning light</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<p>The seat belt warning light and warning sound operate under the following conditions to let you know the importance of wearing a seat belt.</p>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e01076">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
				<colspec colnum="1" colname="1" colwidth="50*"/>
				<colspec colnum="2" colname="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="1" colsep="0">
							<fig id="e01077">
								<title>Front</title>
								<figgroup>
									<image href="../../images/N_CT25Z002_1.eps" scale="95" align="center" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="2">
							<fig id="e01078">
								<title>Rear</title>
								<figgroup>
									<image href="../../images/N_CT25Z004.eps" scale="95" align="center" placement="break"/>
								</figgroup>
							</fig>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<ol outputclass="callout">
			<li>
				<p>2nd row seats left side</p>
			</li>
			<li>
				<p>2nd row seats center side</p>
			</li>
			<li>
				<p>2nd row seats right side</p>
			</li>
		</ol>
	</conbody>
