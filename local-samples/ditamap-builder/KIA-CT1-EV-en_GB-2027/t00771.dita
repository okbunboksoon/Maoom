									</figgroup>
								</fig>
							</entry>
							<entry align="center" colname="col4">
								<p>Buzzer beeps intermittently</p>
							</entry>
						</row>
						<row rowsep="1" valign="middle">
							<entry align="center" colname="col1">
								<p>30–60 cm (12–24 in)</p>
							</entry>
							<entry colname="col2">
								<fig id="e02496">
									<figgroup>
										<image href="../../images/N_CT25Z144.eps" scale="50" align="center" placement="break" outputclass="nolabel"/>
									</figgroup>
								</fig>
							</entry>
							<entry colname="col3">
								<fig id="e02497">
									<figgroup>
										<image href="../../images/N_CT25Z147.eps" scale="50" align="center" placement="break" outputclass="nolabel"/>
									</figgroup>
								</fig>
							</entry>
							<entry align="center" colname="col4">
								<p>Beeps more frequently</p>
							</entry>
						</row>
						<row rowsep="0" valign="middle">
							<entry align="center" colname="col1">
								<p>Within 30 cm (12 in)</p>
							</entry>
							<entry colname="col2">
								<fig id="e02498">
									<figgroup>
