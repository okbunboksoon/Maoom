<concept id="t00148">
	<title>LCD display modes</title>
	<conbody id="e00728">
		<table colsep="1" frame="none" outputclass="formatc" rowsep="1">
			<tgroup cols="2" colsep="1" outputclass="formatc" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="30*"/>
				<colspec colname="col2" colnum="2" colwidth="70*"/>
				<thead>
					<row rowsep="1">
						<entry colname="col1">
							<p>View</p>
