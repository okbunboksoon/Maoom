<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" deliveryTarget="except_print" id="t00300">
	<title>Charging connector lock</title>
	<conbody>
		<p>You may select when the charging connector can be locked and unlocked in the charging inlet.</p>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig>
								<figgroup>
									<image align="center" href="../../images/N_CT25Q021_E.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout">
								<li>
									<p> <uicontrol>AC charger</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Lock charging cable</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Always</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>While charging</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Do not lock</uicontrol> </p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<section deliveryTarget="except_digital">
			<title>Simple operation</title>
			<ul>
				<li>
					<p>Select <menucascade><uicontrol>Electric Vehicle</uicontrol><uicontrol>Reserved charging icon</uicontrol><uicontrol>AC charger</uicontrol></menucascade> in the infotainment system.</p>
				</li>
			</ul>
		</section>
		<section deliveryTarget="except_print">
			<title>Operation</title>
			<ul>
				<li>
					<p>Select <menucascade><uicontrol>Electric Vehicle</uicontrol><uicontrol>Reserved charging icon</uicontrol><uicontrol>AC charger</uicontrol></menucascade> in the infotainment system.</p>
				</li>
			</ul>
		</section>
	</conbody>
</concept>