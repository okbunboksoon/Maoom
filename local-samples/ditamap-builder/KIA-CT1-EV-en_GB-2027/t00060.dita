<concept id="t00060">
	<title id="e00253">Locking/unlocking with mechanical key</title>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e00254">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
				<colspec colnum="1" colname="1" colwidth="50*"/>
				<colspec colnum="2" colname="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="1" colsep="0">
							<fig id="e00255">
								<figgroup>
									<image href="../../images/N_CT25C012_1.eps" scale="95" align="center" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry>
							<fig id="e00256">
								<figgroup>
									<image href="../../images/N_CT25C012.eps" scale="95" align="center" placement="break"/>
								</figgroup>
							</fig>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<section deliveryTarget="except_digital">
			<title>Simple operation</title>
			<ol>
				<li>
					<p>Press the front part of the door handle to pull out the rear part of the door handle.</p>
				</li>
				<li>
					<p>Insert the key with the sharp edge side on the ground direction. The surface of the panel can be damaged if it’s on opposite direction.</p>
				</li>
				<li>
					<p>Turn the key.</p>
				</li>
			</ol>
		</section>
		<section deliveryTarget="except_print">
			<title>Operation</title>
			<ol id="e00257">
				<li>
					<p>Press the front part of the door handle to pull out the rear part of the door handle.</p>
				</li>
				<li>
					<p>Insert the key with the sharp edge side on the ground direction. The surface of the panel can be damaged if it’s on opposite direction.</p>
				</li>
				<li>
					<p>Turn the key.</p>
					<ul id="e00258">
						<li>
							<p>Locking: Clockwise</p>
						</li>
						<li>
							<p>Unlocking: Counter-clockwise</p>
						</li>
					</ul>
				</li>
			</ol>
		</section>
	</conbody>
</concept>