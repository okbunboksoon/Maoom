<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00471">
	<title>To release Electronic Parking Brake (EPB) manually</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>electronic parking brake (EPB) 
					<indexterm>to release Electronic Parking Brake (EPB) manually</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e01908">
			<tgroup cols="2" colsep="1" outputclass="formatc" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="col1" colsep="0">
							<fig id="e01909">
								<figgroup>
									<image align="center" href="../../images/N_CT25D001_1_E.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2"/>
					</row>
				</tbody>
			</tgroup>
		</table>
		<section id="e01910">
			<title>Operation</title>
			<ol id="e01911">
				<li>
					<p>Press the <term translate="no">EV</term> button to the <term translate="no">POWER ON</term> or <term translate="no">DRIVE READY</term> position.</p>
				</li>
				<li>
					<p>Press the <term translate="no">EPB</term> switch while depressing the brake pedal.</p>
					<p>Make sure the Electronic Parking Brake (<term translate="no">EPB</term>) is released and the parking brake warning light (<image align="left" href="../../images/WKIA_127.eps" scale="15" placement="inline"/>) goes off.</p>
				</li>
			</ol>
		</section>
	</conbody>
</concept>