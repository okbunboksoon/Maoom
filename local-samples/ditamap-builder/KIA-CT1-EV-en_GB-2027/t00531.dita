<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" importance="optional" id="t00531">
	<title>Lane-Change Oncoming function</title>
	<conbody>
		<p>The Lane-change oncoming function is warned and controlled in the following way.</p>
		<ul id="e02090">
			<li>
				<p>Collision Warning</p>
			</li>
			<li>
				<p>Emergency Steering</p>
			</li>
		</ul>
		<note type="note" id="e02091">
			<ul id="e02092">
				<li>
					<p>The following warning message will appear on the LCD display.</p>
					<p>For more details, refer to the warning and control section of the function.</p>
					<ul id="e02093">
						<li>
							<p importance="high">Collision warning</p>
						</li>
						<li>
							<p importance="high">Emergency steering</p>
						</li>
					</ul>
				</li>
			</ul>
		</note>
	</conbody>
</concept>