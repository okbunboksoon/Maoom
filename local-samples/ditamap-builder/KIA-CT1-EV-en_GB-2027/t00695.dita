<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00695">
	<title>Turning Lane Following Assist On/Off</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1">
			<tgroup cols="2" colsep="1" outputclass="formatc" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="col1" colsep="0">
							<fig>
								<figgroup>
									<image align="center" href="../../images/N_CT25E030_1.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<p>With the vehicle is in <term translate="no">DRIVE READY</term>, shortly press the Lane Driving Assist button located on the steering wheel to turn on Lane Following Assist. The gray or white (<image align="left" href="../../images/WKIA_011.eps" scale="15" placement="inline"/>) indicator light will appear on the cluster.</p>
							<p>Press the Lane Driving Assist button again to turn off Lane Following Assist.</p>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
	</conbody>
</concept>