<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept id="t00127">
	<title>Initializing the Auto Reverse function</title>
	<conbody>
		<section deliveryTarget="except_digital">
			<title>Simple operation</title>
			<ol>
				<li>
					<p>Shift to P (Park), then move the switch to 'L' or 'R' depending on the mirror you want to adjust.</p>
				</li>
				<li>
					<p>Shift to R (Reverse), then adjust the mirror higher than the standard angle.</p>
				</li>
				<li>
					<p>Shift to another gear position.</p>
				</li>
			</ol>
		</section>
		<section deliveryTarget="except_print">
			<title>Operation</title>
			<ol>
				<li>
					<p>Shift to P (Park).</p>
				</li>
				<li>
					<p>Move the switch to the L or R position depending on the mirror you want to adjust.</p>
				</li>
				<li>
					<p>Shift to R (Reverse).</p>
				</li>
				<li>
					<p>Adjust the mirror higher than the standard angle.</p>
				</li>
				<li>
					<p>Shift to another gear position.</p>
				</li>
			</ol>
		</section>
	</conbody>
</concept>