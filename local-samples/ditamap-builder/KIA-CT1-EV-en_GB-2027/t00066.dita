<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00066">
	<title id="e00269">Unlocking with the door handle</title>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e00270">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
				<colspec colnum="1" colname="1" colwidth="50*"/>
				<colspec colnum="2" colname="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="1" colsep="0">
							<fig id="e00271">
								<figgroup>
									<image align="center" placement="break" href="../../images/N_CT25C014_1.eps" scale="95"/>
								</figgroup>
							</fig>
						</entry>
						<entry/>
					</row>
				</tbody>
			</tgroup>
		</table>
		<section deliveryTarget="except_digital">
			<title>Simple operation</title>
			<ul>
				<li>
					<p>Pull the door handle once for the front door, twice for the rear door.</p>
				</li>
			</ul>
		</section>
		<section deliveryTarget="except_print">
			<title>Operation</title>
			<ul>
				<li>
					<p>Pull the door handle.</p>
					<ul>
						<li>
							<p>Front door: Once (The door will be opened automatically)</p>
						</li>
						<li>
							<p>Rear door: Twice</p>
						</li>
					</ul>
				</li>
			</ul>
		</section>
	</conbody>
</concept>