<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00815">
	<title>Components of the Tire Mobility Kit</title>
	<conbody>
		<fig expanse="page">
			<figgroup>
				<image align="center" href="../../images/N_CT25F028_3.eps" scale="95" placement="break"/>
			</figgroup>
		</fig>
		<p importance="default">Connectors, cable and compressor hose are stored in the compressor housing.</p>
		<p importance="default">Strictly follow the specified sequence, otherwise the sealant may escape under high pressure.</p>
		<ol outputclass="callout">
			<li>
				<p>Sealant bottle filling hose</p>
			</li>
			<li>
				<p>Compressor hose connector</p>
			</li>
			<li>
				<p>Tire inflation pressure adjustment valve</p>
			</li>
			<li>
				<p>Compressor connector</p>
			</li>
			<li>
				<p>Tire pressure control valve</p>
			</li>
			<li>
				<p>Tire inflation pressure gauge</p>
			</li>
			<li>
				<p>Compressor</p>
			</li>
			<li>
				<p>Compressor <term translate="no">ON/OFF</term> switch</p>
			</li>
			<li>
				<p>Speed restriction label</p>
			</li>
			<li>
				<p>Sealant bottle</p>
			</li>
			<li>
				<p>Vehicle power outlet connector/cable</p>
			</li>
			<li>
				<p>Compressor hose</p>
			</li>
		</ol>
	</conbody>
</concept>