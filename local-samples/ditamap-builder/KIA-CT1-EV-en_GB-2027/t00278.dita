<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Top" id="t00278">
	<title>Nearby stations</title>
	<conbody>
		<p importance="high">For more detailed information, please refer to Navigation Quick Reference Guide.</p>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig>
								<figgroup>
									<image align="center" href="../../images/N_CT25Q010_E.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<p>Select the icon and see the map from the infotainment system screen. Stations around the current location are searched.</p>
						</entry>
					</row>
					<row rowsep="1">
						<entry colname="col1">
							<fig>
								<figgroup>
									<image align="center" href="../../images/N_CT25Q025_E.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<p>Around the course, around the current site, around the selected destination or charging stations of interest will be searched. If you choose the charging station, the detailed information will be provided.</p>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
	</conbody>
</concept>