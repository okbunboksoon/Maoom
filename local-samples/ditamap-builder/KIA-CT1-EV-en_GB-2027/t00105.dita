<concept id="t00105">
	<title>Emergency trunk safety release</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>power trunk 
					<indexterm>emergency trunk safety release</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e00510">
			<title>Inside the trunk</title>
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
				<colspec colnum="1" colname="1" colwidth="50*"/>
