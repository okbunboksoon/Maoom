<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept id="t00182">
	<title>System setting</title>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e00867">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
				<colspec colnum="1" colname="1" colwidth="50*"/>
				<colspec colnum="2" colname="2" colwidth="50*"/>
				<tbody>
					<row rowsep="0">
						<entry colname="1" colsep="0">
							<fig id="e00868">
								<figgroup>
									<image href="../../images/N_CT25Z094_E.eps" scale="95" align="center" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="2">
							<ol outputclass="callout" id="e00869">
								<li>
									<p> <uicontrol>Lights</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Intelligent High Beams</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Faster than 60 km/h</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Faster than 40 km/h</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Faster than 20 km/h</uicontrol> </p>
								</li>
								<li>
									<p> <uicontrol>Off</uicontrol> </p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p>With the vehicle in the <term translate="no">POWER ON</term> or <term translate="no">DRIVE READY</term> position, select <menucascade><uicontrol>Settings</uicontrol><uicontrol>Vehicle</uicontrol><uicontrol>Lights</uicontrol><uicontrol>Intelligent High Beams</uicontrol></menucascade> in the Infotainment System screen to turn on Intelligent Front-Lighting System and deselect to turn off the system.</p>
		<note type="warning" id="e00870">
			<p>For your safety, change the Settings after parking the vehicle at a safe location.</p>
		</note>
	</conbody>
</concept>