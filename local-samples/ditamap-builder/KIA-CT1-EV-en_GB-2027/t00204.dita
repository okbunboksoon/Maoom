<concept importance="optional" id="t00204">
	<title>Lumbar support</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig expanse="page">
								<figgroup>
									<image align="center" href="../../images/N_CT25B006_1.eps" scale="95" placement="break"/>
