<concept id="t00108">
	<title id="e00534">Opening/closing the hood</title>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e00535">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
