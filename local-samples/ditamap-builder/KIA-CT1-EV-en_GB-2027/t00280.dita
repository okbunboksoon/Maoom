<concept base="Anywhere" deliveryTarget="except_print" id="t00280">
	<title>Next departure/Departure time</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig>
								<figgroup>
									<image align="center" href="../../images/N_CT25Q011_E.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<p>Set anticipated departure time for scheduled charging and target temperature.</p>
						</entry>
					</row>
					<row rowsep="1">
						<entry colname="col1">
							<fig>
								<figgroup>
									<image align="center" href="../../images/N_CT25Q012_E.eps" scale="95" placement="break"/>
								</figgroup>
							</fig>
