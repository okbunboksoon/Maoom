					<row rowsep="1">
						<entry align="center" nameend="col2" namest="col1" valign="middle">
							<p>How to Charge</p>
						</entry>
						<entry align="center" colname="col3" valign="middle">
							<p>Use AC charger installed at home or public charging station</p>
						</entry>
						<entry align="center" colname="col4" valign="middle">
							<p>Use the DC charger at public charging station</p>
						</entry>
						<entry align="center" colname="col5" valign="middle">
							<p>Use household current</p>
						</entry>
					</row>
