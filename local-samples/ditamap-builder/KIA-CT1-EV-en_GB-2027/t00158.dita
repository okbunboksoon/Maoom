								</li>
								<li id="e00784">
									<p importance="optional">SCC set speed information</p>
								</li>
								<li>
									<p importance="optional">Lane Following Assist information</p>
								</li>
								<li>
									<p importance="optional">SCC vehicle distance information</p>
								</li>
								<li>
									<p importance="optional">Surrounding vehicle information</p>
								</li>
								<li id="e00785">
									<p>Blind-Spot Safety information</p>
								</li>
								<li id="e00786">
									<p>Speedometer information</p>
