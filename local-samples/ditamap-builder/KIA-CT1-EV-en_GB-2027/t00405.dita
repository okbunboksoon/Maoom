							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout" id="e01663">
								<li>
									<p>Bracket</p>
								</li>
								<li>
									<p>Swing it to the side</p>
								</li>
								<li>
									<p>Slide the sun visor</p>
								</li>
								<li>
									<p>Mirror cover</p>
