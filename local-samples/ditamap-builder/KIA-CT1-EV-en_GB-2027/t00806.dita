<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00806">
	<title>Vehicle malfunctions or non-operating conditions</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>vehicle malfunctions or non-operating conditions</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc" pgwide="true" rowsep="1">
			<tgroup cols="2" colsep="1" outputclass="formatc" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="33*"/>
				<colspec colname="col2" colnum="2" colwidth="67*"/>
				<thead>
					<row rowsep="1">
						<entry colname="col1">
							<p>Malfunction</p>
						</entry>
						<entry colname="col2">
							<p>Operation</p>
						</entry>
					</row>
				</thead>
				<tbody>
					<row rowsep="1" valign="middle">
						<entry colname="col1">
							<p>If the vehicle stalls while driving</p>
						</entry>
						<entry colname="col2">
							<ol>
								<li>
									<p>Reduce your speed and keep straight.</p>
								</li>
								<li>
									<p>Stop the vehicle in a safe place.</p>
								</li>
								<li>
									<p>Turn the hazard warning flasher on.</p>
								</li>
								<li>
									<p>Restart the vehicle.</p>
								</li>
							</ol>
						</entry>
					</row>
					<row rowsep="1" valign="middle">
						<entry colname="col1">
							<p>If the vehicle stalls at a crossroad or crossing</p>
						</entry>
						<entry colname="col2">
							<ol>
								<li>
									<p>Shift to N (Neutral).</p>
								</li>
								<li>
									<p>Push the vehicle to a safe place.</p>
								</li>
							</ol>
						</entry>
					</row>
					<row rowsep="1" valign="middle">
						<entry colname="col1">
							<p>If you have a flat tire while driving</p>
						</entry>
						<entry colname="col2">
							<ol>
								<li>
									<p>Reduce your speed slowly and keep straight.</p>
								</li>
								<li>
									<p>Stop the vehicle in a safe, level place away from traffic.</p>
								</li>
								<li>
									<p>Turn the hazard warning flasher on.</p>
								</li>
								<li>
									<p>Set the parking brake.</p>
								</li>
								<li>
									<p>Shift to P (Park).</p>
								</li>
								<li>
									<p>Have all passengers get out of the vehicle and move away from traffic.</p>
								</li>
							</ol>
							<p>Refer to <xref type="concept" href="t00812.dita#t00812">Tire Mobility Kit</xref>.</p>
						</entry>
					</row>
					<row rowsep="1" valign="middle">
						<entry colname="col1">
							<p>If the vehicle does not start</p>
						</entry>
						<entry colname="col2">
							<ul>
								<li>
									<p>Be sure P (Park) gear position is selected. The vehicle starts only when P (Park) gear position is selected.</p>
								</li>
								<li>
									<p>Check the 12-volt battery connections to be sure they are clean and tight.</p>
								</li>
								<li>
									<p>Turn on the interior light. If the light dims or goes out when you operate the starter, the 12V battery is drained.</p>
								</li>
							</ul>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
	</conbody>
</concept>