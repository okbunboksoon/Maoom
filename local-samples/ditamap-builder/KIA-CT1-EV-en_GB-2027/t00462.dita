<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00462">
	<title>Parking brake</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>stopping the vehicle 
					<indexterm>parking brake</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<p>Check if the brake warning light <image align="left" href="../../images/WKIA_127.eps" scale="15" placement="inline"/> illuminates when the vehicle is in <term translate="no">POWER ON</term> position. Be sure the parking brake is fully released and the brake warning light <image align="left" href="../../images/WKIA_127.eps" scale="15" placement="inline"/> is turned off before driving.</p>
	</conbody>
</concept>