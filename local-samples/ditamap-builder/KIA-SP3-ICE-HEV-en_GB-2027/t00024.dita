							<p>Smartstream G1.6 GDi HEV/Smartstream G1.6 GDi HEV (EURO 7)</p>
						</entry>
						<entry colname="col4" align="center" valign="middle">
							<p>38</p>
						</entry>
					</row>
				</tbody>
