<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept base="Anywhere" id="t00520">
	<title>Safe Exit</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e03442">
			<tgroup cols="2" colsep="1" rowsep="1">
				<colspec colname="col1" colnum="1" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e03443">
								<image href="images/N_TK25Z016_E.jpg" scale="95" align="center" placement="break"/>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout" id="e03444">
								<li>
									<p><uicontrol>Driver Assistance</uicontrol></p>
								</li>
								<li>
									<p><uicontrol>Driving Safety</uicontrol></p>
								</li>
								<li>
									<p><uicontrol>SEA (Safe Exit Assist)</uicontrol></p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p>While the vehicle is <term translate="no">ON</term>, tap <menucascade><uicontrol>Setup</uicontrol><uicontrol>Vehicle</uicontrol><uicontrol>Driver Assistance</uicontrol><uicontrol>Driving Safety</uicontrol><uicontrol>Safe Exit</uicontrol></menucascade> on the infotainment system screen.</p>
		<note type="warning">
			<p>If you deselect Safe Exit, Safe Exit Warning cannot warn you. You should always be aware of your surroundings.</p>
		</note>
		<note type="tip">
			<p>If you restart the vehicle, Safe Exit Warning maintains its last setting.</p>
		</note>
	</conbody>
	<related-links>
		<linkpool>
			<link format="dita" href="t00519.dita#t00519" role="parent" scope="local" type="concept">
				<linktext>Safe Exit Warning settings</linktext>
			</link>
		</linkpool>
	</related-links>
</concept>