<concept otherprops="legalnotice_europe-general_gen-mid_2023_20230101_00006" id="t00189">
	<title>Headlight leveling adjustment switch</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>headlight leveling adjustment switch</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<section importance="optional" otherprops="legalnotice_europe-general_egall_4_2023_20230101_00002" id="e01165">
			<title>Manual type</title>
			<table frame="none" outputclass="formatc_none" rowsep="0" colsep="0" id="e01166">
				<tgroup cols="2" colsep="0" rowsep="0">
					<colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
					<colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
					<tbody>
						<row rowsep="0">
							<entry colname="col1">
								<fig id="e01167">
									<image href="images/N_SP327_B05_020_1.jpg" scale="95" align="center" placement="break"/>
								</fig>
							</entry>
							<entry colname="col2"/>
						</row>
					</tbody>
				</tgroup>
			</table>
			<ul id="e01168">
				<li>
					<p>The higher the switch position number, the lower the headlight beam level.</p>
				</li>
				<li>
					<p>Always keep the headlamp beam properly leveled to avoid dazzling other road users.</p>
				</li>
			</ul>
			<table colsep="1" frame="none" outputclass="formatc" rowsep="1" id="e01169">
				<tgroup cols="2" colsep="1" outputclass="formatc" rowsep="1">
					<colspec colname="col1" colnum="1" colwidth="50*"/>
					<colspec colname="col2" colnum="2" colwidth="50*"/>
					<thead>
						<row rowsep="1">
							<entry align="center" colname="col1" valign="middle">
								<p>Loading condition</p>
							</entry>
							<entry align="center" colname="col2" valign="middle">
								<p>Switch position</p>
							</entry>
						</row>
					</thead>
					<tbody>
						<row rowsep="1">
							<entry align="left" colname="col1" valign="middle">
								<p>Driver only</p>
							</entry>
							<entry align="center" colname="col2" valign="middle">
								<p>0</p>
							</entry>
						</row>
						<row>
							<entry align="left" colname="col1" valign="middle">
								<p>Driver + Front passenger</p>
							</entry>
							<entry align="center" colname="col2" valign="middle">
								<p>0</p>
							</entry>
						</row>
						<row>
							<entry align="left" colname="col1" valign="middle">
								<p>Full passengers (including driver)</p>
							</entry>
							<entry align="center" colname="col2" valign="middle">
								<p>1</p>
							</entry>
						</row>
						<row>
							<entry align="left" colname="col1" valign="middle">
								<p>Full passengers (including driver) + Maximum permissible loading</p>
							</entry>
							<entry align="center" colname="col2" valign="middle">
								<p>2</p>
							</entry>
						</row>
						<row rowsep="1">
							<entry align="left" colname="col1" valign="middle">
								<p>Driver + Maximum permissible loading</p>
							</entry>
							<entry align="center" colname="col2" valign="middle">
								<p>3</p>
							</entry>
						</row>
					</tbody>
				</tgroup>
			</table>
		</section>
