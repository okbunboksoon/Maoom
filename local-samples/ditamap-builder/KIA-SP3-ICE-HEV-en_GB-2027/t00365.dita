<concept base="Anywhere" id="t00365">
	<title>Before entering the vehicle</title>
	<shortdesc/>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>before entering the vehicle</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<ul id="e02353">
			<li>
				<p>Ensure that all windows, outside mirrors, and outside lights are clean.</p>
			</li>
			<li>
				<p>Check the condition of the tires.</p>
			</li>
			<li>
				<p>Check under the vehicle for any sign of leaks.</p>
			</li>
			<li>
				<p>Be sure there are no obstacles behind you if you intend to back up.</p>
			</li>
		</ul>
	</conbody>
	<related-links>
		<linkpool>
			<link format="dita" href="t00363.dita#t00363" role="parent" scope="local" type="concept">
				<linktext>Before driving</linktext>
			</link>
		</linkpool>
	</related-links>
</concept>