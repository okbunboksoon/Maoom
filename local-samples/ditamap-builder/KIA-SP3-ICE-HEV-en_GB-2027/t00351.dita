<concept id="t00351">
	<title>Air ventilation seat</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>interior features
					<indexterm>air ventilation seat</indexterm>
				</indexterm>
				<indexterm>air ventilation seat</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e02225">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
