<concept id="t00101">
	<title id="e00525">Hood open warning </title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>hood
					<indexterm>hood open warning</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<p>The hood warning message will appear on the LCD display when hood is open.</p>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e00526">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
