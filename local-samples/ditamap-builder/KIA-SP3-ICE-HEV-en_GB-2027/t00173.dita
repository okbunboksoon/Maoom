<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd">
<concept id="t00173">
	<title>High Beam Assist setting</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e01091">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e01092">
								<image href="images/N_TK25Z042_E.jpg" scale="95" align="center" placement="break"/>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout" id="e01093">
								<li>
									<p><uicontrol>Lights</uicontrol></p>
								</li>
								<li>
									<p><uicontrol>HBA (High Beam Assist)</uicontrol></p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p>With the <term translate="no">ENGINE START/STOP</term> button <term translate="no">ON</term>, select <menucascade><uicontrol>Setup</uicontrol><uicontrol>Vehicle</uicontrol><uicontrol>Lights</uicontrol><uicontrol>High Beam Assist</uicontrol></menucascade> in the <uicontrol>Settings</uicontrol> menu to turn on the High Beam Assist function.</p>
		<note type="warning">
			<p>For your safety, change the settings only after parking the vehicle at a safe location.</p>
		</note>
	</conbody>
	<related-links>
		<linkpool>
			<link format="dita" href="t00172.dita#t00172" role="parent" scope="local" type="concept">
				<linktext>High Beam Assist (HBA)</linktext>
			</link>
		</linkpool>
	</related-links>
</concept>