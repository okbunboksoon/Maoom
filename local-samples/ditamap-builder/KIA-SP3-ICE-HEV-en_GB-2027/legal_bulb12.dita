<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="bulb12" otherprops="legalnotice_europe-general_egall_2023_20230101_0000923">
    <title>Side repeater lamp (bulb type) bulb replacement</title>
    <shortdesc/>
    <prolog>
        <metadata>
            <keywords>
                <indexterm>replacing side repeater lamp (Bulb type)</indexterm>
            </keywords>
        </metadata>
    </prolog>
    <conbody>
        <table outputclass="formatc_none" frame="none" rowsep="0" colsep="0" id="table_hsq_3fj_pjc">
            <tgroup cols="2" colsep="0" rowsep="0">
                <colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
                <colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
                <tbody>
                    <row rowsep="0">
                        <entry colname="col1">
                            <fig id="fig_isq_3fj_pjc">
                                <figgroup>
                                    <image href="images/OJAPE073044.jpg" scale="95"
                                        align="center" placement="break" id="image_jsq_3fj_pjc"/>
                                </figgroup>
                            </fig>
                        </entry>
                        <entry colname="col2"/>
                    </row>
                </tbody>
            </tgroup>
        </table>
        <ol id="ol_ksq_3fj_pjc">
            <li>
                <p>Apply the parking brake and turn the ignition to "OFF".</p>
            </li>
            <li>
                <p>Turn off the lights.</p>
            </li>
            <li>
                <p>Remove the lens by pulling it forward from the vehicle.</p>
            </li>
            <li>
                <p>Disconnect the bulb connector.</p>
            </li>
            <li>
                <p>Remove the bulb socket from the body by turning it counterclockwise.</p>
            </li>
            <li>
                <p>Install a new bulb and install in the reverse order of removal.</p>
            </li>
        </ol>
    </conbody>
</concept>
