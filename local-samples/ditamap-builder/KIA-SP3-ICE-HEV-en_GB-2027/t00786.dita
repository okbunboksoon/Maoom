<concept otherprops="legalnotice_europe-general_gen-mid_2023_20230101_00014" id="t00786">
	<title>Emergency Call (eCall) System operation</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e04786">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="1*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="1.05*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e04787">
								<figgroup>
									<image align="center" href="images/N_SP327_D10_005_1_E.jpg" scale="95" placement="break"/>
								</figgroup>
							</fig>
						</entry>
						<entry colname="col2">
							<ol outputclass="callout" id="e04788">
								<li>
									<p><term translate="no">SOS</term> warning light</p>
								</li>
								<li>
									<p><term translate="no">SOS</term> button</p>
								</li>
								<li>
									<p>Microphone</p>
								</li>
							</ol>
						</entry>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p><term translate="no">SOS</term> warning light: The <term translate="no">SOS</term> warning light appears on the instrument cluster for 3 seconds when the vehicle is in <term translate="no">POWER ON</term> position. Other than that, they will disappear during normal operation of the vehicle.</p>
		<p><term translate="no">SOS</term> button: The driver/passenger makes an emergency call to the Public Safety Answering Point (PSAP) by pressing the button.</p>
		<p>If there is a problem with the system, the <term translate="no">SOS</term> warning light will remain illuminated on the instrument cluster.</p>
	</conbody>
