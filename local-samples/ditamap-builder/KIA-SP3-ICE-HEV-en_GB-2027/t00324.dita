<concept importance="optional" id="t00324">
	<title>Automatic climate control system</title>
	<shortdesc>The automatic climate control system cools or heats the inside of the vehicle for the comfort of you and your passengers.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>automatic climate control system</indexterm>
			</keywords>
		</metadata>
	</prolog>
