<concept base="Top" id="t00156">
	<title id="e00772">LCD display modes </title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>LCD display
					<indexterm>LCD display modes</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody id="e00773">
		<section id="e00774">
			<p>The LCD display has 3 modes. You can switch modes by pressing the Mode button.</p>
			<table frame="all" rowsep="1" colsep="1" pgwide="1" outputclass="formatc" id="e00775">
				<tgroup cols="2" colsep="1" rowsep="1">
					<colspec colnum="1" colname="col1" colwidth="0.692*"/>
					<colspec colnum="2" colname="col2" colwidth="1.566*"/>
					<thead>
						<row rowsep="1" valign="middle">
							<entry colname="col1">
								<p>View</p>
							</entry>
							<entry colname="col2">
								<p>Description</p>
							</entry>
						</row>
					</thead>
					<tbody>
						<row rowsep="1">
							<entry colname="col1" align="center" valign="middle">
								<p>Driving Assist view</p>
							</entry>
							<entry colname="col2" align="left" valign="middle">
								<p>Displays information related to the Driver assistance system</p>
							</entry>
						</row>
						<row rowsep="1">
							<entry colname="col1" align="center" valign="middle">
								<p>Navigation view</p>
							</entry>
							<entry colname="col2" align="left" valign="middle">
								<p>Displays information related to the navigation system</p>
							</entry>
						</row>
						<row rowsep="0">
							<entry colname="col1" align="center" valign="middle">
								<p>Utility information view</p>
							</entry>
							<entry colname="col2" align="left">
								<p>Displays information related to driving, warnings, and so on</p>
							</entry>
						</row>
					</tbody>
				</tgroup>
			</table>
		</section>
	</conbody>
