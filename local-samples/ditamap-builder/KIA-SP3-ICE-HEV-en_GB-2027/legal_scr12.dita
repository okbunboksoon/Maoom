<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="scr12">
    <title>SCR warning light (Diesel engine) <image href="images/WKIA_053.jpg"
            scale="15" align="left" placement="inline" id="image_jgm_mz3_pjc"/></title>
    <shortdesc/>
    <conbody>
        <p>This warning light appears: </p>
        <ul id="ul_z51_mz3_pjc">
            <li>
                <p>When the urea solution tank is nearly empty.</p>
            </li>
        </ul>
        <p>If the urea solution tank is nearly empty: </p>
        <ul id="ul_av1_mz3_pjc">
            <li>
                <p>Refill urea solution as soon as possible.</p>
            </li>
        </ul>
    </conbody>
</concept>
