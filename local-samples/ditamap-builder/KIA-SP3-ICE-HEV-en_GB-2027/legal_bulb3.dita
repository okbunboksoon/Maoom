<concept id="t00935" otherprops="legalnotice_europe-general_egall_2023_20230101_0000930">
    <title>Replacing license plate lamp (Bulb type)</title>
    <prolog>
        <metadata>
            <keywords>
                <indexterm>replacing license plate lamp (Bulb type)</indexterm>
            </keywords>
        </metadata>
    </prolog>
    <conbody>
        <table outputclass="formatc_none" frame="none" rowsep="0" colsep="0" id="table_ppn_c2j_pjc">
            <tgroup cols="2" colsep="0" rowsep="0">
                <colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
                <colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
                <tbody>
                    <row rowsep="0">
                        <entry colname="col1">
                            <fig id="fig_qpn_c2j_pjc">
                                <figgroup>
                                    <image href="images/OKA4H073038.jpg" scale="95"
                                        align="center" placement="break" id="image_rpn_c2j_pjc"/>
                                </figgroup>
                            </fig>
                        </entry>
                        <entry colname="col2"/>
                    </row>
                </tbody>
            </tgroup>
        </table>
        <ol id="ol_spn_c2j_pjc">
            <li>
                <p>Turn off vehicle and disconnect the negative terminal from the battery.</p>
            </li>
            <li>
                <p>Using a screwdriver, gently pry the lamp assembly.</p>
            </li>
            <li>
                <p>Remove the bulb by pulling it straight out.</p>
            </li>
            <li>
                <p>Install a new bulb in the socket.</p>
            </li>
            <li>
                <p>Install the lamp assembly.</p>
            </li>
        </ol>
        <note type="caution" id="note_tpn_c2j_pjc">
            <p>Be careful not to dirty or damage the lens, lens tab, and plastic housings.</p>
        </note>
    </conbody>
</concept>
