<concept id="t00311">
	<title>Ambient light</title>
	<shortdesc>The ambient lights are applied to the front instrument panel and front door.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>interior lights
					<indexterm>ambient light</indexterm>
				</indexterm>
			</keywords>
