<concept importance="optional" otherprops="legalnotice_europe-general_egall_2023_20230101_0003012" id="t00153">
	<title>Dual clutch transmission shift indicator</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e00759">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e00760">
								<image href="images/N_SP3i25_C00_005_IR.jpg" scale="95" align="center" placement="break"/>
							</fig>
						</entry>
						<entry colname="col2"/>
					</row>
				</tbody>
			</tgroup>
		</table>
		<p>This indicator displays which shift lever is selected.</p>
		<ul id="e00761">
			<li>
				<p>Park: P</p>
			</li>
			<li>
				<p>Reverse: R</p>
			</li>
			<li>
				<p>Neutral: N</p>
			</li>
			<li>
				<p>Drive: D1, D2, D3, D4, D5, D6, D7*</p>
			</li>
			<li>
				<p>Manual mode: S1, S2, S3, S4, S5, S6, S7*</p>
			</li>
		</ul>
		<p>*: if equipped</p>
	</conbody>
