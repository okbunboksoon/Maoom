	<title>Power tailgate open/close button (smart key, instrument panel)</title>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e00411">
			<tgroup cols="2" colsep="0" rowsep="1">
