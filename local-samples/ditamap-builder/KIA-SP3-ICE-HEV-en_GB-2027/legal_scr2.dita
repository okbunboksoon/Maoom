<concept importance="optional" id="t00947">
    <title>Urea solution level gauge</title>
    <conbody>
        <table outputclass="formatc_none" frame="none" rowsep="0" colsep="0" id="table_fmr_sy3_pjc">
            <tgroup cols="2" colsep="0" rowsep="0">
                <colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
                <colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
                <tbody>
                    <row rowsep="0">
                        <entry colname="col1">
                            <fig id="fig_gmr_sy3_pjc">
                                <figgroup>
                                    <image href="images/OMQ4033118L.jpg" scale="95"
