<concept id="t00048">
	<title>With the remote key</title>
	<conbody>
		<table frame="none" colsep="1" rowsep="1" outputclass="formatc_none" id="e00243">
			<tgroup cols="2" colsep="1" rowsep="1" outputclass="formatc">
