<task importance="optional" id="t00187">
	<title>Front fog light operation</title>
	<shortdesc>Front fog lights are designed to improve visibility in fog, rain, or snow.</shortdesc>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>lighting control
					<indexterm>front fog light operation</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<taskbody>
		<context id="e01151">
			<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e01152">
				<tgroup cols="2" colsep="0" rowsep="1">
					<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
					<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
					<tbody>
						<row rowsep="1">
							<entry colname="col1">
								<fig id="e01153">
									<image align="center" placement="break" scale="95" href="images/N_SP327_B05_009.jpg"/>
								</fig>
							</entry>
							<entry colname="col2"/>
						</row>
					</tbody>
				</tgroup>
			</table>
		</context>
		<steps-unordered id="e01154">
			<step>
				<cmd>To turn on the fog lights, turn the fog light switch (1) <term translate="no">ON</term> after turning the headlights on.</cmd>
			</step>
			<step>
				<cmd>To turn off the fog lights, turn the fog light switch (1) to the <term translate="no">OFF</term> position.</cmd>
			</step>
		</steps-unordered>
		<postreq id="e01155">
			<note type="note" id="e01156">
				<p>The fog lights consume large amounts of vehicle electrical power when in operation. Only use the fog lights when visibility is poor.</p>
			</note>
		</postreq>
	</taskbody>
