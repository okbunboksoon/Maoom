<task id="t00318">
	<title>Heating and air conditioning (A/C) operation</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>manual climate control system
					<indexterm>manual heating and air conditioning (A/C) operation</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<taskbody>
		<context id="e02021">
			<fig id="e02022">
				<image href="images/N_SP327_C08_053.jpg" scale="95" align="center" placement="break"/>
			</fig>
			<p>To manually operate the heating and <term translate="no">A/C</term>, follow these steps:</p>
		</context>
		<steps id="e02023">
			<step>
				<cmd>Start the vehicle.</cmd>
			</step>
			<step>
				<cmd>Set the desired mode.</cmd>
				<choices id="e02024">
					<choice>
						<p>Heating: <image href="images/WKIA_062.jpg" scale="15" align="left" placement="inline"/></p>
					</choice>
					<choice>
						<p>Cooling: <image href="images/WKIA_060.jpg" scale="15" align="left" placement="inline"/></p>
					</choice>
				</choices>
			</step>
			<step>
				<cmd>Set the temperature control as desired.</cmd>
			</step>
			<step>
				<cmd>Set the air intake control to external air.</cmd>
			</step>
			<step>
				<cmd>Set the desired fan speed. Turn the <term translate="no">A/C</term> system on if desired.</cmd>
			</step>
		</steps>
	</taskbody>
