	<title id="e00747">Outside temperature gauge </title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>gauges
					<indexterm>outside temperature gauge</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e00748">
			<tgroup cols="2" colsep="0" rowsep="1">
				<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
				<colspec colname="col2" colnum="2" colsep="0" colwidth="50*"/>
				<tbody>
					<row rowsep="1">
						<entry colname="col1">
							<fig id="e00749">
								<image href="images/N_QVe27_C00_098_E.jpg" scale="95" align="center" placement="break"/>
							</fig>
						</entry>
						<entry colname="col2"/>
