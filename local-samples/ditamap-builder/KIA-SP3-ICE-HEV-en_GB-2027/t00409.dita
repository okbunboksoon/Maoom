<concept id="t00409">
	<title>Applying AUTO HOLD function</title>
	<prolog>
		<metadata>
			<keywords>
				<indexterm>AUTO HOLD
					<indexterm>applying</indexterm>
				</indexterm>
			</keywords>
		</metadata>
	</prolog>
	<conbody>
