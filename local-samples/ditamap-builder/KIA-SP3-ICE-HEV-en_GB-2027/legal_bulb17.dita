<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="bulb17" otherprops="legalnotice_europe-general_egall_2023_20230101_0000921">
    <title>Position lamp (Bulb type) bulb replacement</title>
    <shortdesc/>
    <prolog>
        <metadata>
            <keywords>
                <indexterm>position lamp (bulb type) bulb replacement (headlamp type A)</indexterm>
            </keywords>
        </metadata>
    </prolog>
    <conbody>
        <table outputclass="formatc_none" frame="none" rowsep="0" colsep="0" id="table_gcr_yfj_pjc">
            <tgroup cols="2" colsep="0" rowsep="0">
                <colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
                <colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
                <tbody>
                    <row rowsep="0">
                        <entry colname="col1">
                            <fig id="fig_hcr_yfj_pjc">
                                <title>Headlamp Type A</title>
                                <figgroup>
                                    <image href="images/OJAPE073036.jpg" scale="95"
                                        align="center" placement="break" id="image_icr_yfj_pjc"/>
                                </figgroup>
                            </fig>
                        </entry>
                        <entry colname="col2"/>
                    </row>
                </tbody>
            </tgroup>
        </table>
        <ol id="ol_jcr_yfj_pjc">
            <li>
                <p>Open the hood</p>
            </li>
            <li>
                <p>Remove the headlamp bulb cover by turning it counterclockwise.</p>
            </li>
            <li>
                <p>Remove the bulb-socket from the headlamp assembly by pulling it out.</p>
            </li>
            <li>
                <p>Remove the bulb from bulb-socket by pulling it out.</p>
            </li>
            <li>
                <p>Insert a new bulb by inserting it into the bulb-socket.</p>
            </li>
            <li>
                <p>Install the bulb-socket in the headlamp assembly. Install the headlamp bulb cover
                    by turning it clockwise.</p>
            </li>
        </ol>
    </conbody>
</concept>
