		<section importance="optional" id="e05249">
			<title>Front fog lamp aiming</title>
			<table colsep="1" frame="none" outputclass="formatc_none" rowsep="1" id="e05250">
				<tgroup cols="2" colsep="0" rowsep="1">
					<colspec colname="col1" colnum="1" colsep="0" colwidth="50*"/>
