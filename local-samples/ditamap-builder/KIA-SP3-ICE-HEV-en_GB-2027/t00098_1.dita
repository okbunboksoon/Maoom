<concept id="t00098_1" importance="optional">
    <title>Remote window closing/opening (power window lock button)</title>
    <shortdesc/>
    <conbody>
            <table outputclass="formatc_none" frame="none" rowsep="0" colsep="0"
                id="table_l42_3p4_43c">
                <tgroup cols="2" colsep="0" rowsep="0">
                    <colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
                    <colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
                    <tbody>
                        <row rowsep="0">
                            <entry colname="col1">
                                <fig id="fig_m42_3p4_43c">
                                    <figgroup>
                                        <image href="images/N_SP3i26_B04_047_E.jpg"
                                            align="center" placement="break" scale="95" id="e00545"
                                        />
                                    </figgroup>
                                </fig>
                            </entry>
                            <entry colname="col2">
                                <ol outputclass="callout" id="e00546">
                                    <li>
                                        <p>Door lock button <image href="images/WKIA_019.jpg"
                                                align="left" width="0.157in" height="0.157in"
                                                placement="inline" outputclass="nolabel" id="e00547"
                                            /></p>
                                    </li>
                                    <li>
                                        <p>Door unlock button <image
                                                href="images/WKIA_021.jpg" align="left"
                                                width="0.157in" height="0.157in" placement="inline"
                                                outputclass="nolabel" id="e00548"/></p>
                                    </li>
