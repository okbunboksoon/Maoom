<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA Concept//EN" "concept.dtd">
<concept id="bulb14" otherprops="legalnotice_europe-general_egall_2023_20230101_0000915">
    <title>Position lamp/Daytime running lamp (Bulb type) bulb replacement (Headlamp Type A)</title>
    <shortdesc/>
    <prolog>
        <metadata>
            <keywords>
                <indexterm>position lamp (bulb type) bulb replacement (headlamp type A)</indexterm>
            </keywords>
        </metadata>
    </prolog>
    <conbody>
        <table outputclass="formatc_none" frame="none" rowsep="0" colsep="0" id="table_gcr_yfj_pjc">
            <tgroup cols="2" colsep="0" rowsep="0">
                <colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
                <colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
                <tbody>
                    <row rowsep="0">
                        <entry colname="col1">
                            <fig id="fig_hcr_yfj_pjc">
                                <title>Headlamp Type A</title>
                                <figgroup>
                                    <image href="images/OJAPE073036.jpg" scale="95"
                                        align="center" placement="break" id="image_icr_yfj_pjc"/>
                                </figgroup>
                            </fig>
                        </entry>
                        <entry colname="col2"/>
                    </row>
                </tbody>
            </tgroup>
        </table>
        <ol id="ol_jcr_yfj_pjc">
            <li>
                <p>Apply the parking brake and turn the ignition to "OFF".</p>
            </li>
            <li>
                <p>Turn off the lights.</p>
            </li>
            <li>
                <p>Open the hood and remove the Position &amp; Daytime Running Lamp assembly by
                    turning it counterclockwise.</p>
            </li>
            <li>
                <p>Install a new bulb and Install in reverse order of removal.</p>
            </li>
        </ol>
    </conbody>
</concept>
