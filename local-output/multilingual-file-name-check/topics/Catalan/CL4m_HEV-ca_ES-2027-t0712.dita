						<row rowsep="0" valign="middle">
							<entry colname="col1" align="center">
								<p>innerhalb von 30 cm (12 Zoll)</p>
							</entry>
							<entry colname="col2" align="center" valign="middle">
								<fig>
									<figgroup>
										<image align="center" href="../../images/WKIA_098.eps" scale="30" placement="inline"/>
									</figgroup>
								</fig>
							</entry>
