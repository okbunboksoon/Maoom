									</figgroup>
								</fig>
							</entry>
							<entry colname="col4" align="center">
								<p>-</p>
							</entry>
						</row>
						<row rowsep="1" valign="middle">
							<entry colname="col1" align="center">
								<p>30 – 60 cm (12 – 24 in.)</p>
							</entry>
							<entry colname="col2" align="center" valign="middle">
								<fig>
									<figgroup>
										<image align="center" href="../../images/WKIA_096.eps" scale="30" placement="inline"/>
									</figgroup>
								</fig>
							</entry>
							<entry colname="col3" align="center" valign="middle">
								<fig>
									<figgroup>
										<image align="center" href="../../images/WKIA_097.eps" scale="30" placement="inline"/>
									</figgroup>
								</fig>
							</entry>
							<entry colname="col4" align="center">
								<p>-</p>
							</entry>
