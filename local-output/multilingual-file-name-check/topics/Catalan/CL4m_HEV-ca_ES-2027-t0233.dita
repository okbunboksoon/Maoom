					<row rowsep="1" valign="middle">
						<entry colname="col1" valign="middle">
							<p>Gewichtsgruppe</p>
						</entry>
						<entry colname="col2">
							<p>Name</p>
						</entry>
						<entry colname="col3" align="center" valign="middle">
							<p>Hersteller</p>
						</entry>
						<entry colname="col4">
							<p>Art der Befestigung</p>
						</entry>
						<entry colname="col5">
							<p>ECE</p>
