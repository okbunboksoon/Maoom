<concept id="CL4m_HEV-ca_ES-2027-t0233">
	<title>Empfohlene Kinderrückhaltesysteme für Fahrzeuge gemäß UN-Vorschriften (Für Lateinamerika) (Informationen für Fahrzeugnutzer und Hersteller von Kinderrückhaltesystemen)</title>
	<conbody>
		<table frame="all" rowsep="1" colsep="1" pgwide="1" outputclass="formatc">
			<tgroup cols="5" colsep="1" rowsep="1">
				<colspec colnum="1" colname="col1" colwidth="0.521*"/>
				<colspec colnum="2" colname="col2" colwidth="0.798*"/>
				<colspec colnum="3" colname="col3" colwidth="0.866*"/>
				<colspec colnum="4" colname="col4" colwidth="1.621*"/>
				<colspec colnum="5" colname="col5" colwidth="0.875*"/>
