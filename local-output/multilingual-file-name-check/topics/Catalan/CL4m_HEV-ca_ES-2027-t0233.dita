						<entry colname="col2" align="center" valign="middle">
							<p>JOIE i SPIN 360</p>
						</entry>
						<entry colname="col3" align="center" valign="middle">
							<p>JOIE</p>
						</entry>
						<entry colname="col4" align="center" valign="middle">
							<p>Typ ISOFIX mit Stützbein</p>
							<p>(nach hinten und nach vorne gerichtet)</p>
						</entry>
						<entry colname="col5" align="center" valign="middle">
							<p>E11–030513</p>
						</entry>
					</row>
				</tbody>
