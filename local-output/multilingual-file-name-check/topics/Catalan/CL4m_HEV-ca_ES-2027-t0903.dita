						<entry namest="col1" nameend="col2">
							<p>Batterietyp (falls vorhanden)</p>
						</entry>
					</row>
				</thead>
				<tbody>
					<row rowsep="1">
						<entry colname="col1" align="center" valign="middle">
							<p>Batterie für Elektrofahrzeuge</p>
						</entry>
						<entry colname="col2" align="center" valign="middle">
							<p>SLI-Batterie</p>
						</entry>
					</row>
					<row rowsep="0">
