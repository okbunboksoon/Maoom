									<title>Typ D</title>
									<figgroup>
										<image align="center" href="../../images/OCL4MGTL036011L.eps" scale="95" placement="break"/>
									</figgroup>
								</fig>
							</entry>
						</row>
					</tbody>
				</tgroup>
