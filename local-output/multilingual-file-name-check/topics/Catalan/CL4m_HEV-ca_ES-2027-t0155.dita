										</figgroup>
									</fig>
								</entry>
								<entry colname="col2">
									<fig id="e00457">
										<title>Typ B</title>
										<figgroup>
											<image align="center" href="../../images/OBL7M043062.eps" scale="95" placement="break"/>
										</figgroup>
									</fig>
								</entry>
							</row>
							<row rowsep="0">
								<entry colname="col1">
									<fig id="e00458">
										<title>Typ C</title>
										<figgroup>
											<image align="center" href="../../images/OCL4MGTL034006R.eps" scale="95" placement="break"/>
										</figgroup>
									</fig>
								</entry>
								<entry colname="col2">
