			</keywords>
		</metadata>
	</prolog>
	<conbody>
		<table outputclass="formatc_none" frame="none" rowsep="0" colsep="0" id="e00699">
			<tgroup cols="2" colsep="0" rowsep="0">
				<colspec colnum="1" colname="col1" colwidth="2.343*" colsep="0"/>
				<colspec colnum="2" colname="col2" colwidth="2.343*" colsep="0"/>
				<tbody>
					<row rowsep="0">
						<entry colname="col1">
							<fig expanse="page" id="e00700">
								<title>Anzeige der Klimaanlage</title>
								<figgroup>
